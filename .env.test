# Database (ephemeral PGlite socket connection; overwritten by integration globalSetup)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL_UNPOOLED=postgresql://postgres:postgres@127.0.0.1:5432/postgres

# Neon Auth
NEON_AUTH_BASE_URL=https://test.neonauth.us-east-1.aws.neon.tech/neondb/auth
NEON_AUTH_COOKIE_SECRET=test_neon_auth_cookie_secret_at_least_32_characters_long

# AWS S3 Storage
AWS_ENDPOINT_URL_S3=https://test-s3.growfin.local
AWS_ACCESS_KEY_ID=test_aws_access_key_id
AWS_SECRET_ACCESS_KEY=test_aws_secret_access_key
AWS_REGION=ap-southeast-1
AWS_BUCKET_NAME=growfin-media

# Midtrans Payment Gateway
MIDTRANS_CLIENT_KEY=SB-Mid-client-test-key
MIDTRANS_SERVER_KEY=SB-Mid-server-test-key
MIDTRANS_IS_PRODUCTION=false
NEXT_PUBLIC_MIDTRANS_CLIENT_KEY=SB-Mid-client-test-key

# External APIs
GEMINI_API_KEY=test_gemini_api_key
GOOGLE_MAPS_API_KEY=test_google_maps_api_key
RESEND_API_KEY=re_test_resend_api_key

# App & Domain Configuration
NEXT_PUBLIC_BASE_DOMAIN=growfin.test
ADMIN_EMAILS=admin@growfin.test
CRON_SECRET=test_cron_secret_token_here_at_least_32_characters
ANALYTICS_HASH_SECRET=test_analytics_hash_secret_token_at_least_32_characters
EMAIL_FROM=Growfin Digital <auth@growfin.my.id>
