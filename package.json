{
  "name": "growfin-digital",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "run-s db:migrate build:next",
    "build:local": "run-p db-server:memory build:next --race",
    "build:next": "next build",
    "db-server:file": "pglite-server --max-connections=10 --db=.temp/db --run 'pnpm run db:migrate'",
    "db-server:memory": "pglite-server --max-connections=10 --run 'pnpm run db:migrate'",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:pull": "drizzle-kit pull",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "dev": "run-p db-server:file dev:next",
    "dev:next": "next dev",
    "fmt": "oxfmt --write --no-error-on-unmatched-pattern",
    "knip": "knip --cache",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "start": "next start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@base-ui/react": "^1.9.0",
    "@neon/auth": "^0.8.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^1.0.0-rc.5",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.69.0",
    "next": "16.4.5",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "^6.37.0",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@ashtrath/oxc-config": "^0.1.1",
    "@ashtrath/skills": "^0.1.0",
    "@electric-sql/pglite-socket": "^0.2.18",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^26",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/browser-playwright": "^5.1.0",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "^1.0.0-rc.5",
    "knip": "^6.44.1",
    "npm-run-all2": "^9.0.4",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "oxlint-tailwindcss": "^1.17.1",
    "tailwindcss": "^4",
    "typescript": "^7",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.16.1"
    }
  },
  "packageManager": "pnpm@12.16.1"
}
